# ---------------------------------------------------------------
# IISc Sharodiya Durgotsab — environment
# Copy to .env.local for development. Set the same keys in Vercel.
# Never commit the filled-in file.
# ---------------------------------------------------------------

# --- Supabase (free tier) -> https://supabase.com/dashboard ---
# Project Settings > API. The service role key is server-only and
# must never be prefixed with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin sign-in -------------------------------------------
# Any random string of 32+ characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Three kinds of account. Format is "name:passphrase" separated by
# commas. A name may appear in one list only; if it appears in two,
# the stronger role wins.
#
# admin      everything: approving and rejecting donations, deleting a
#            pending one, the expense ledger, the site's own copy, the
#            CSV export and the visit figures.
# committee  enters donations collected in person, sees the running
#            total, reads the enquiry inbox and the contact sheet, and
#            can send a receipt. Cannot decide that a donation counts.
# viewer     the public board, behind a named login.
ADMIN_USERS=
COMMITTEE_USERS=
VIEWER_USERS=

# ADMIN_PASSWORD still works and sets up a single shared administrator
# called "admin". Do not use it. Every verification is stamped with the
# name that performed it, and that record is the committee's defence if
# anybody ever questions the accounts. A shared login turns the whole
# audit trail into the constant string "admin".

# --- Payment display ------------------------------------------
# UPI VPA of the committee account, shown on the donate page.
NEXT_PUBLIC_UPI_ID=

# --- External tally (optional) ---------------------------------
# Google Apps Script web-app URL. Every verified donation is
# mirrored to a spreadsheet the treasurer can audit independently.
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=

# --- Receipt by email (optional) -------------------------------
# Set ONE provider. Both have a free tier big enough for a festival:
# Resend gives 100 messages a day, Brevo 300. The sending address must
# belong to a domain you have verified with that provider.
RESEND_API_KEY=
BREVO_API_KEY=
MAIL_FROM="IISc Sharodiya Durgotsab <receipts@yourdomain>"

# --- Receipt by WhatsApp (optional) ----------------------------
# Without these, the console opens WhatsApp with the message already
# written and a committee member presses send. That costs nothing.
# With them, the server sends it. Requires a Meta business account.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en

# --- Pujo Guide, the on-site assistant (optional) --------------
# Free key from https://console.groq.com or https://aistudio.google.com
# Without a key the guide falls back to on-page search.
GROQ_API_KEY=
GEMINI_API_KEY=

# --- The address -----------------------------------------------
# Overrides the default so moving to a real domain needs no code
# change. No trailing slash. Example:
#   NEXT_PUBLIC_SITE_URL=https://iiscsharodiyadurgotsab.in
NEXT_PUBLIC_SITE_URL=

# A note that has cost people an evening: passphrases are not trimmed.
# The list is split on commas, so "a:pass , b:pw" gives a the
# passphrase "pass " with a trailing space and locks them out with no
# error message. A space after the comma is fine; one before it is not.

# --- Receipts over a self-hosted WhatsApp gateway (optional) ----
# OpenWA (github.com/rmyndharis/OpenWA) is a self-hosted gateway that
# drives WhatsApp through reverse-engineered clients rather than
# Meta's official API. Its own README is blunt about the consequence:
# "There is always a non-zero risk of account restriction or ban."
#
# If you use it, three rules:
#   Use a spare SIM. Never a personal number carrying a bank and a
#   family group; a restriction often cannot be appealed.
#   Host it somewhere always-on. It holds a live session and several
#   hundred megabytes of headless browser, so it cannot run on Vercel.
#   Warm the number up for a few days and send receipts spread out
#   rather than in a burst.
#
# The sender is whichever number that session is linked to. It is
# never named here, so changing the SIM is a change on the gateway.
OPENWA_URL=
OPENWA_API_KEY=
OPENWA_SESSION=

# Where a donor's reply should land. The From address has to be a
# domain you control; this does not.
MAIL_REPLY_TO=
