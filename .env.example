# ---------------------------------------------------------------
# IISc Sharodiya Durgotsab — environment
# Copy to .env.local for development. Set the same keys in Vercel.
# Never commit the filled-in file.
# ---------------------------------------------------------------

# --- Supabase (free tier) -> https://supabase.com/dashboard ---
# Project Settings > API. The service role key is server-only and
# must never be prefixed with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin sign-in -------------------------------------------
# Any random string of 32+ characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# One login per committee member: "user:password,user2:password2"
ADMIN_USERS=

# Or a single shared login (username becomes "admin")
ADMIN_PASSWORD=

# --- Payment display ------------------------------------------
# UPI VPA of the committee account, shown on the donate page.
NEXT_PUBLIC_UPI_ID=

# --- External tally (optional) ---------------------------------
# Google Apps Script web-app URL. Every verified donation is
# mirrored to a spreadsheet the treasurer can audit independently.
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=

# --- Pujo Guide, the on-site assistant (optional) --------------
# Free key from https://console.groq.com or https://aistudio.google.com
# Without a key the guide falls back to on-page search.
GROQ_API_KEY=
GEMINI_API_KEY=
